# Copy to .env and fill in. Never commit .env.
#
# Only BLEEP_ADMIN_PASSWORD and BLEEP_SECRET must be here: the dashboard is behind them. Every key,
# token and plugin address marked "(or dashboard)" below can be set from the dashboard instead, on
# the Settings page, where each shows as set or missing and has an input and a Clear button
# (docs/setup.md, "Keys and tokens"; this file is the other way). Bleep keeps such a value in
# secrets.json on the data volume, mode 0600, never in the database, and uses it without a
# restart. A value set here wins and cannot be changed from the dashboard. A backup of the data
# volume holds the dashboard's secrets in clear.

# Bleep
# The dashboard login. At least 12 characters; Bleep refuses to start with a shorter one.
BLEEP_ADMIN_PASSWORD=
# Long random string; keys sessions and approval signatures.
BLEEP_SECRET=
# Set true once the dashboard is served over https, so the session cookie is Secure.
BLEEP_COOKIE_SECURE=false
# The dev panel (models, prompts, budgets, cost, guard log; docs/design/dev-panel.md). Off unless
# true: its routes are a 404 and its nav entry hidden.
BLEEP_DEV_PANEL=false
# Where a browser reaches the dashboard, e.g. http://192.168.1.5:3000. Optional; when set, the
# last Telegram message of an incident links to its page there.
BLEEP_DASHBOARD_URL=
# Seconds between watcher checks of each host (default 15).
# BLEEP_WATCH_INTERVAL_S=15
# Watcher checks after Bleep's own machine wakes from sleep in which a host not answering is not
# counted (default 4; docs/design/watcher.md).
# BLEEP_WAKE_GRACE_TICKS=4
# Hosts file inside the backend container. Unset, compose uses /config/hosts.demo.yaml (the demo
# profile). For your own hosts, copy config/hosts.example.yaml to config/hosts.yaml and set
# BLEEP_HOSTS_FILE=/config/hosts.yaml. See docs/setup.md.
BLEEP_HOSTS_FILE=

# Models: LLM_PROVIDER is openrouter or local.
LLM_PROVIDER=openrouter
# Main model id. Unset: openai/gpt-6-luna (docs/decisions/chat-model.md).
LLM_MODEL=
# Small model for one-line recovery explanations. Unset: openai/gpt-6-luna.
LLM_CHEAP_MODEL=
# (or dashboard)
OPENROUTER_API_KEY=
# OpenAI-compatible endpoint for the local option, e.g. http://host.docker.internal:1234/v1
LOCAL_BASE_URL=
# Local model id. Unset: openai/gpt-oss-20b, the one measured (docs/decisions/chat-model.md);
# its largest prompt was about 7k tokens, measured at a 32k context.
LOCAL_MODEL=

# Embeddings for long-term memory. Unset, a local model inside the backend does it (no key, no
# network). EMBEDDINGS_PROVIDER=openai uses an OpenAI-compatible /embeddings endpoint instead and
# needs the base URL and the model; EMBEDDINGS_MODEL is ignored without it. A model change
# re-embeds the memory on the next start.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
# Memory recall's cut-off, 0 to 1. Unset: the model's measured one (bge-small 0.5, bge-m3 0.35),
# else 0.5 (docs/evals/embeddings-min-score-2026-11-06.md).
EMBEDDINGS_MIN_SCORE=
# (or dashboard)
EMBEDDINGS_API_KEY=

# Telegram (optional): approvals and alerts. Only this chat is answered. (or dashboard, both)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (optional, docs/setup.md): a fine-grained token, limited to the services' repos, with
# Contents and Metadata read-only. It reads commits and diffs, and the docs for knowledge search.
# Unset: public repos only, 60 requests an hour. (or dashboard)
GITHUB_TOKEN=

# Plugins (optional). Each address and its token (or dashboard, both): they come together from one
# place, and a new address set on the dashboard clears its token and switches the plugin off. From
# the dashboard an address must be https to public addresses; plain http or a private network
# address (a Docker service name, 192.168.x, Tailscale) goes here.
# Coolify (docs/design/plugins.md): where it answers, https unless a private address or a Docker
# service name (the token travels with every request), and an API token from Keys & Tokens >
# API tokens with the read, deploy and write permissions only: not root and not read:sensitive.
COOLIFY_URL=
COOLIFY_TOKEN=
# MCP server by URL (docs/design/plugins.md): its Streamable HTTP endpoint, https unless a
# private address or a Docker service name (the token travels with every request), and its
# bearer token, if it takes one
MCP_URL=
MCP_TOKEN=

# Evals (backend/evals/README.md): the judge, an OpenRouter model id (needs OPENROUTER_API_KEY),
# claude-code, or manual. Unset: openai/gpt-6-luna, which is also the default model under test, and
# the harness refuses a judge that is the model under test. With the default cloud model under test,
# set another model, claude-code or manual.
EVAL_JUDGE_MODEL=

# Observability (optional, docs/design/observability.md). TRACING is off, langfuse or langsmith;
# unset, nothing is traced. docker-compose.observability.yaml sets it to langfuse and passes the
# project keys below to the backend. The keys LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY and
# LANGSMITH_API_KEY (or dashboard); TRACING and the addresses stay here.
TRACING=
# Self-hosted Langfuse (--profile observability). The project, its keys and the login are created
# from these on first start. Keys: pk-lf-... and sk-lf-... of your choosing; the other three with
# openssl rand -hex 32. The UI is http://localhost:3001; set LANGFUSE_UI_URL when a browser reaches
# it at another address (the trace links and Langfuse's login use it).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Langfuse elsewhere (its cloud or your own server), without the profile: TRACING=langfuse and
# LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL, and for the trace links on the
# incidents LANGFUSE_UI_URL and LANGFUSE_PROJECT_ID.
# LangSmith (its free Developer plan is enough): TRACING=langsmith and an API key from its
# Settings > API Keys. LANGSMITH_ENDPOINT only for the EU region:
# https://eu.api.smith.langchain.com. Leave LANGSMITH_TRACING unset: Bleep adds its own tracer.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=bleep
