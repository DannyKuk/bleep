# Copy to .env and fill in. Never commit .env.

# Bleep
# The dashboard login. At least 12 characters; Bleep refuses to start with a shorter one.
BLEEP_ADMIN_PASSWORD=
# Long random string; keys sessions and approval signatures.
BLEEP_SECRET=
# Set true once the dashboard is served over https, so the session cookie is Secure.
BLEEP_COOKIE_SECURE=false
# Seconds between watcher checks of each host (default 15).
# BLEEP_WATCH_INTERVAL_S=15
# Hosts file inside the backend container. Unset, compose uses /config/hosts.demo.yaml (the demo
# profile). For your own hosts, copy config/hosts.example.yaml to config/hosts.yaml and set
# BLEEP_HOSTS_FILE=/config/hosts.yaml. See docs/setup.md.
BLEEP_HOSTS_FILE=

# Models: LLM_PROVIDER is openrouter or local.
LLM_PROVIDER=openrouter
# Main model id. Unset: openai/gpt-6-luna (docs/decisions/chat-model.md).
LLM_MODEL=
# Small model for one-line recovery explanations. Unset: openai/gpt-6-luna.
LLM_CHEAP_MODEL=
OPENROUTER_API_KEY=
# OpenAI-compatible endpoint for the local option, e.g. http://host.docker.internal:1234/v1
LOCAL_BASE_URL=
# Local model id. Unset: openai/gpt-oss-20b, the one measured (docs/decisions/chat-model.md);
# its largest prompt was about 7k tokens, measured at a 32k context.
LOCAL_MODEL=

# Embeddings for long-term memory. Unset, a local model inside the backend does it (no key, no
# network). EMBEDDINGS_PROVIDER=openai uses an OpenAI-compatible /embeddings endpoint instead and
# needs the base URL and the model; EMBEDDINGS_MODEL is ignored without it. A model change
# re-embeds the memory on the next start.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=

# Telegram (optional): approvals and alerts. Only this chat is answered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Plugins (optional)
GITHUB_TOKEN=
COOLIFY_TOKEN=

# Evals (backend/evals/README.md): the judge, an OpenRouter model id (needs OPENROUTER_API_KEY)
# or claude-code. Unset: openai/gpt-6-luna. It is never the model under test.
EVAL_JUDGE_MODEL=

# Observability (optional): set to on to send traces.
TRACING=
